{
  "name": "petabytemind",
  "version": "1.1.0",
  "description": "PetaByteMind \u2014 cinematic IDE & systems portfolio on Cloudflare Workers (Next.js + D1 + KV + Durable Objects).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:ci": "bash scripts/cf-ci.sh",
    "deploy": "bash scripts/cf-ci.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M11F20/petabytemind.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/M11F20/petabytemind/issues"
  },
  "homepage": "https://github.com/M11F20/petabytemind#readme",
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.67.0",
    "next": "^16.4.5",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "typescript": "^5.6.3",
    "wrangler": "^4.158.0"
  },
  "private": true
}
